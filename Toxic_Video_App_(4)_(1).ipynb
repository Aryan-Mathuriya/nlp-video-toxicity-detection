        "def predict_toxic(text, model, vect):\n",
        "    comment_text = text\n",
        "    comment ={'id':[1],'comment_text':[comment_text]}\n",
        "    comment = pd.DataFrame(comment)\n",
        "    return make_test_predictions(comment, model, vect)"
      ]
